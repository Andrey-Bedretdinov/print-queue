{
  "name": "print-queue",
  "version": "1.11.1",
  "description": "Compact print queue manager for Windows 10/11",
  "author": {
    "name": "Andrey Bedretdinov",
    "email": "andrey.bedretdinov@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "icon": "node scripts/make-icon.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && npm run icon && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --publish never",
    "pack": "npm run build && electron-builder --win --dir --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  },
  "build": {
    "appId": "com.bedretdinov.printqueue",
    "publish": [
      {
        "provider": "github",
        "owner": "Andrey-Bedretdinov",
        "repo": "print-queue"
      }
    ],
    "productName": "Print Queue",
    "copyright": "Andrey Bedretdinov",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "artifactName": "PrintQueue-${version}-win-${arch}.${ext}",
      "signtoolOptions": {
        "publisherName": "Andrey Bedretdinov"
      },
      "legalTrademarks": "MIT License",
      "requestedExecutionLevel": "requireAdministrator",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Очередь печати",
      "runAfterFinish": true,
      "artifactName": "PrintQueue-${version}-setup.${ext}"
    },
    "compression": "normal"
  }
}
